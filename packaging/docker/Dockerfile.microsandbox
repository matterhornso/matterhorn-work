FROM node:22-bookworm-slim AS openwork-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && corepack enable \
  && corepack prepare pnpm@10.27.0 --activate \
  && pnpm --allow-build=bun add --global --global-dir /opt/runtime-toolchain --global-bin-dir /usr/local/bin bun@1.3.14 \
  && test "$(bun --version)" = "1.3.14" \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN mkdir -p /out && chown node:node /out
USER node
RUN node scripts/build-pinned-opencode.mjs --output /out/opencode
USER root

RUN pnpm install --frozen-lockfile --filter matterhorn-work-orchestrator... --filter matterhorn-work-server... \
  && pnpm --filter matterhorn-work-orchestrator build:bin \
  && pnpm --filter matterhorn-work-server build:bin

FROM node:22-bookworm-slim

ARG OPENWORK_ORCHESTRATOR_VERSION
ARG OPENWORK_SERVER_VERSION
ARG OPENCODE_VERSION

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=openwork-builder /src/apps/orchestrator/dist/bin/matterhorn-work /usr/local/bin/matterhorn-work
COPY --from=openwork-builder /src/apps/orchestrator/dist/bin/openwork /usr/local/bin/openwork
COPY --from=openwork-builder /src/apps/server/dist/bin/matterhorn-work-server /usr/local/bin/matterhorn-work-server
COPY --from=openwork-builder /src/apps/server/dist/bin/openwork-server /usr/local/bin/openwork-server
COPY --from=openwork-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh
COPY --from=openwork-builder /out/opencode /usr/local/bin/opencode
COPY --from=openwork-builder /out/opencode.provenance.json /usr/local/share/matterhorn/opencode.provenance.json
COPY --from=openwork-builder /out/opencode.LICENSE /usr/local/share/matterhorn/opencode.LICENSE
COPY --from=openwork-builder /out/opencode.models.dev-LICENSE /usr/local/share/matterhorn/opencode.models.dev-LICENSE

RUN set -eux; \
  test -n "$OPENWORK_ORCHESTRATOR_VERSION"; \
  test -n "$OPENWORK_SERVER_VERSION"; \
  test -n "$OPENCODE_VERSION"; \
  test "$(opencode --version)" = "$OPENCODE_VERSION"; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh

RUN test "$(matterhorn-work --version)" = "$OPENWORK_ORCHESTRATOR_VERSION" \
  && test "$(matterhorn-work-server --version)" = "$OPENWORK_SERVER_VERSION" \
  && opencode --version

ENV OPENWORK_DATA_DIR=/data/openwork-orchestrator
ENV OPENWORK_SIDECAR_DIR=/data/sidecars
ENV OPENWORK_WORKSPACE=/workspace
ENV OPENCODE_DISABLE_AUTOUPDATE=true
ENV OPENCODE_DISABLE_MODELS_FETCH=true

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${OPENWORK_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
