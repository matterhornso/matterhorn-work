# Public Beta web tier: builds the SPA from this exact checkout and serves it
# with the same-origin control-plane proxy (api/matterhorn-proxy.mjs).
FROM node:22-bookworm-slim AS build
RUN npm install --global "pnpm@10.27.0"
WORKDIR /app
COPY . /app
ARG VITE_MATTERHORN_BUILD_COMMIT
ENV VITE_MATTERHORN_BUILD_COMMIT=${VITE_MATTERHORN_BUILD_COMMIT}
RUN pnpm install --frozen-lockfile --ignore-scripts --prefer-offline \
  && pnpm --filter @matterhorn-work/app build:web

FROM oven/bun:1.3-slim AS runtime
WORKDIR /app
COPY --from=build /app/apps/app/dist /app/apps/app/dist
COPY vercel.json /app/vercel.json
COPY api/matterhorn-proxy.mjs /app/api/matterhorn-proxy.mjs
COPY packaging/docker/public-beta-web-server.mjs /app/packaging/docker/public-beta-web-server.mjs
ENV NODE_ENV=production
EXPOSE 8080
USER bun
CMD ["bun", "/app/packaging/docker/public-beta-web-server.mjs"]
