FROM node:22-bookworm-slim AS opencode-builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && corepack enable \
  && corepack prepare pnpm@10.27.0 --activate \
  && pnpm --allow-build=bun add --global --global-dir /opt/runtime-toolchain --global-bin-dir /usr/local/bin bun@1.3.14 \
  && test "$(bun --version)" = "1.3.14" \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/build-pinned-opencode.mjs /build/scripts/build-pinned-opencode.mjs
COPY patches/runtime /build/patches/runtime
RUN mkdir -p /out && chown node:node /out
USER node
RUN node scripts/build-pinned-opencode.mjs --output /out/opencode

FROM node:22-bookworm-slim AS runtime

ARG BUN_VERSION=1.3.11

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git gosu tar unzip \
  && npm install --global "bun@${BUN_VERSION}" "pnpm@10.27.0" \
  && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
COPY . /app

RUN pnpm install --frozen-lockfile --ignore-scripts --prefer-offline \
  && pnpm --filter matterhorn-work-server rebuild better-sqlite3 --pending \
  && pnpm --dir packages/crypto-app-sdk build \
  && pnpm store prune

COPY --from=opencode-builder /out/opencode /usr/local/bin/opencode
COPY --from=opencode-builder /out/opencode.provenance.json /usr/local/share/matterhorn/opencode.provenance.json
COPY --from=opencode-builder /out/opencode.LICENSE /usr/local/share/matterhorn/opencode.LICENSE
COPY --from=opencode-builder /out/opencode.models.dev-LICENSE /usr/local/share/matterhorn/opencode.models.dev-LICENSE
RUN gosu node node scripts/verify-opencode-native-contract.mjs \
  --binary /usr/local/bin/opencode \
  --expected-version "$(node -p 'require("./constants.json").opencodeVersion.replace(/^v/, "")')"

RUN mkdir -p /data/matterhorn /data/workspace /data/opencode/xdg/data /data/opencode/xdg/state /home/node/.config \
  && chown -R node:node /app /data /home/node

ENV NODE_ENV=production \
  OPENWORK_HOST=0.0.0.0 \
  OPENWORK_MANAGE_OPENCODE=1 \
  OPENWORK_OPENCODE_BIN=/usr/local/bin/opencode \
  OPENCODE_DISABLE_AUTOUPDATE=true \
  OPENCODE_DISABLE_MODELS_FETCH=true \
  OPENWORK_LOG_FORMAT=json \
  XDG_DATA_HOME=/data/opencode/xdg/data \
  XDG_STATE_HOME=/data/opencode/xdg/state \
  MATTERHORN_WORK_DATA_DIR=/data/matterhorn \
  MATTERHORN_WORK_WORKSPACES=/data/workspace \
  MATTERHORN_WORK_APPROVAL_MODE=manual \
  MATTERHORN_HOSTED_PUBLIC_BETA=1 \
  MATTERHORN_ACCOUNT_MESSAGE_GATEWAY_REQUIRED=1 \
  MATTERHORN_WORK_REQUEST_RATE_LIMIT_ENABLED=true

COPY --chmod=0755 packaging/docker/public-beta-entrypoint.sh /usr/local/bin/matterhorn-public-beta

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${OPENWORK_PORT:-8787}/health/live" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/matterhorn-public-beta"]
