FROM node:22-bookworm-slim AS runtime

ARG BUN_VERSION=1.3.11
ARG OPENCODE_VERSION=1.14.38
ARG TARGETARCH

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git tar unzip \
  && npm install --global "bun@${BUN_VERSION}" "pnpm@10.27.0" \
  && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
COPY . /app

RUN pnpm install --frozen-lockfile --ignore-scripts --prefer-offline \
  && pnpm --filter matterhorn-work-server rebuild better-sqlite3 --pending \
  && pnpm store prune

RUN set -eux; \
  case "${TARGETARCH:-amd64}" in \
    amd64) asset="opencode-linux-x64-baseline.tar.gz" ;; \
    arm64) asset="opencode-linux-arm64.tar.gz" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL --retry 5 --retry-all-errors \
    "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${asset}" \
    -o /tmp/opencode.tar.gz; \
  tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin; \
  chmod 0755 /usr/local/bin/opencode; \
  rm /tmp/opencode.tar.gz; \
  opencode --version

RUN mkdir -p /data/matterhorn /data/workspace /home/node/.config \
  && chown -R node:node /app /data /home/node

ENV NODE_ENV=production \
  OPENWORK_HOST=0.0.0.0 \
  OPENWORK_MANAGE_OPENCODE=1 \
  OPENWORK_OPENCODE_BIN=/usr/local/bin/opencode \
  OPENWORK_LOG_FORMAT=json \
  MATTERHORN_WORK_DATA_DIR=/data/matterhorn \
  MATTERHORN_WORK_WORKSPACES=/data/workspace \
  MATTERHORN_WORK_APPROVAL_MODE=manual \
  MATTERHORN_WORK_REQUEST_RATE_LIMIT_ENABLED=true

COPY --chmod=0755 packaging/docker/public-beta-entrypoint.sh /usr/local/bin/matterhorn-public-beta

USER node
VOLUME ["/data"]
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${OPENWORK_PORT:-8787}/health/live" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/matterhorn-public-beta"]
