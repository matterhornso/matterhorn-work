{
  "name": "@matterhorn-work/crypto-app-sdk",
  "version": "0.1.0",
  "description": "Non-custodial manifest and local policy kit for Matterhorn crypto app adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "import": "./dist/json-schema.js",
      "default": "./dist/json-schema.js"
    }
  },
  "bin": {
    "create-matterhorn-crypto-app": "bin/create-matterhorn-crypto-app.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "bun test src --timeout 15000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matterhornso/matterhorn-work.git",
    "directory": "packages/crypto-app-sdk"
  },
  "devDependencies": {
    "@matterhorn-work/types": "workspace:*",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
