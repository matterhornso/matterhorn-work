{
  "name": "@matterhorn-work/crypto-app-sdk",
  "version": "0.1.0",
  "description": "Non-custodial manifest and local policy kit for Matterhorn crypto app adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "bun test src --timeout 15000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@matterhorn-work/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
