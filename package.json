{
  "name": "@matterhornso/matterhorn-work",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "OPENWORK_DEV_MODE=1 OPENWORK_ELECTRON_REMOTE_DEBUG_PORT=${OPENWORK_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @matterhorn-work/desktop dev",
    "dev:electron": "OPENWORK_DEV_MODE=1 pnpm --filter @matterhorn-work/desktop dev:electron",
    "dev:sandbox": "bash .devcontainer/dev-sandbox.sh",
    "dev:windows": ".\\scripts\\dev-windows.cmd",
    "dev:windows:x64": ".\\scripts\\dev-windows.cmd x64",
    "dev:ui": "OPENWORK_DEV_MODE=1 pnpm --filter @matterhorn-work/app dev",
    "dev:ui-demo": "pnpm --filter @matterhorn-work/ui-demo dev",
    "email:dev": "pnpm --filter @matterhorn-work/email dev",
    "dev:headless-web": "OPENWORK_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @matterhorn-work/app build",
    "preview": "pnpm --filter @matterhorn-work/app preview",
    "typecheck": "pnpm --filter @matterhorn-work/app typecheck",
    "test:health": "pnpm --filter @matterhorn-work/app test:health",
    "test:sessions": "pnpm --filter @matterhorn-work/app test:sessions",
    "test:refactor": "pnpm --filter @matterhorn-work/app test:refactor",
    "test:events": "pnpm --filter @matterhorn-work/app test:events",
    "test:todos": "pnpm --filter @matterhorn-work/app test:todos",
    "test:permissions": "pnpm --filter @matterhorn-work/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @matterhorn-work/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @matterhorn-work/app test:session-scope",
    "test:session-switch": "pnpm --filter @matterhorn-work/app test:session-switch",
    "test:fs-engine": "pnpm --filter @matterhorn-work/app test:fs-engine",
    "test:e2e": "pnpm --filter @matterhorn-work/app test:e2e",
    "test:agent-control-mcp": "node packages/matterhorn-work-mcp/test-smoke.mjs",
    "test:agent-control-coverage-matrix": "node scripts/agent-control-coverage-matrix.test.mjs",
    "test:mcp-config-cli": "node scripts/mcp-config-cli.test.mjs",
    "test:agent-control-api-docs": "node scripts/agent-control-api-docs.test.mjs",
    "test:agent-action-model-contract": "node scripts/agent-action-model-contract.test.mjs",
    "test:agent-browser-control-guide": "node scripts/agent-browser-control-guide.test.mjs",
    "test:agent-browser-live-qa": "node scripts/agent-browser-live-qa.test.mjs",
    "test:agent-session-event-stream-contract": "node scripts/agent-session-event-stream-contract.test.mjs",
    "test:agent-session-progress-smoke": "node scripts/agent-session-progress-smoke.test.mjs",
    "test:cli-packaging-rename": "node scripts/cli-packaging-rename.test.mjs",
    "test:opencode-abstraction-copy": "node scripts/opencode-abstraction-copy.test.mjs",
    "test:orchestrator": "pnpm --filter matterhorn-work-orchestrator test:router",
    "bump:patch": "pnpm --filter @matterhorn-work/app bump:patch",
    "bump:minor": "pnpm --filter @matterhorn-work/app bump:minor",
    "bump:major": "pnpm --filter @matterhorn-work/app bump:major",
    "bump:set": "pnpm --filter @matterhorn-work/app bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "turbo": "^2.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "electron",
      "esbuild",
      "protobufjs"
    ],
    "patchedDependencies": {}
  },
  "packageManager": "pnpm@10.27.0"
}
