# Matterhorn Desks launch configuration
#
# This file contains placeholders only. Store real tokens and provider keys in
# the deployment secret manager. Do not commit a populated .env file.

# Release evidence inputs
MATTERHORN_WORK_SERVER_URL=https://api.matterhorn.example
MATTERHORN_WORK_TOKEN=<client-token-from-secret-manager>
MATTERHORN_WORKSPACE_ID=ws_replace_with_release_workspace
MATTERHORN_APP_URL=https://app.matterhorn.example/workspace/ws_replace_with_release_workspace/session
# Set this to the exact 40-character release commit in the deployed API.
MATTERHORN_BUILD_COMMIT=0000000000000000000000000000000000000000

# Backend runtime and attached Matterhorn Desks engine
OPENWORK_HOST=127.0.0.1
OPENWORK_PORT=8787
MATTERHORN_WORK_HOST_TOKEN=<host-token-from-secret-manager>
MATTERHORN_WORK_WORKSPACES=/srv/matterhorn/workspaces/release
MATTERHORN_WORK_OPENCODE_BASE_URL=http://127.0.0.1:4096
MATTERHORN_WORK_OPENCODE_USERNAME=<engine-username-from-secret-manager>
MATTERHORN_WORK_OPENCODE_PASSWORD=<engine-password-from-secret-manager>
MATTERHORN_WORK_APPROVAL_MODE=manual
MATTERHORN_WORK_APPROVAL_TIMEOUT_MS=30000
MATTERHORN_WORK_CORS_ORIGINS=https://app.matterhorn.example
MATTERHORN_WORK_REQUEST_RATE_LIMIT_ENABLED=true
MATTERHORN_WORK_REQUEST_RATE_LIMIT_WINDOW_MS=60000
MATTERHORN_WORK_REQUEST_RATE_LIMIT_READ_MAX=4800
MATTERHORN_WORK_REQUEST_RATE_LIMIT_WRITE_MAX=240
# Production persists HTTP and account-attempt budgets under the Matterhorn
# data root so restarts and processes sharing the volume cannot reset them.
# Override only when the durable auth volume uses a different path.
# MATTERHORN_WORK_RATE_LIMIT_DB=/srv/matterhorn/data/auth/rate-limits.db
# Set the same high-entropy value on the backend and the Vercel proxy. The
# backend trusts x-matterhorn-client-ip only when this server-side secret matches.
MATTERHORN_WORK_TRUSTED_PROXY_SECRET=<shared-edge-proxy-secret>
# Vercel-only server secrets; never use a VITE_ prefix.
MATTERHORN_CONTROL_PLANE_URL=https://api-origin.matterhorn.example
MATTERHORN_PROXY_SECRET=<same-shared-edge-proxy-secret>

# Live chat and desk-task inference. Store the key only in the deployment
# secret manager; the managed agent runtime reads it from its environment.
CUDOS_API_KEY=<cudos-key-from-secret-manager>
# Guarded agent runtime. Keep `off` until the Phase 5 shadow window begins.
# Both secrets are server-only, independently generated, at least 32 bytes,
# and required in shadow as well as enforce mode.
MATTERHORN_GUARDED_RUNTIME_MODE=off
MATTERHORN_AGENT_RUNTIME_SECRET=<independent-runtime-secret-from-secret-manager>
MATTERHORN_CAPABILITY_SIGNING_SECRET=<independent-capability-signing-secret-from-secret-manager>
# Optional enforce-only rollout selectors. Empty desks means all crypto desks.
# Begin with prepare calls on Sui, then append desks in the documented order;
# switch access to all only after the prepare window is clean.
# MATTERHORN_GUARDED_RUNTIME_ENFORCE_ACCESS=prepare
# MATTERHORN_GUARDED_RUNTIME_ENFORCE_DESKS=sui
# Public signups accept prompts only after the provider's no-training and
# retention terms have been reviewed. These are server-only declarations, not
# browser variables. Do not set them from marketing copy or an unrelated ASI
# product policy.
MATTERHORN_PROVIDER_PRIVACY_MODE=verified-only
MATTERHORN_CUDOS_TRAINING_USE=<none-after-written-provider-review>
MATTERHORN_CUDOS_TRAINING_OPTED_IN=<false-after-checking-provider-account>
MATTERHORN_CUDOS_PRIVACY_POLICY_URL=<https-provider-policy-or-dpa-url>
MATTERHORN_CUDOS_PRIVACY_VERIFIED_AT=<iso-date-of-provider-review>
MATTERHORN_CUDOS_PROMPT_RETENTION_DAYS=<provider-contract-days>
# If the reviewed provider policy has no numeric API retention commitment,
# leave the days unset and explicitly acknowledge policy-based retention.
MATTERHORN_CUDOS_PROMPT_RETENTION_POLICY=<provider-policy-after-review>
# Public beta signup control. Raise capacity deliberately after reviewing usage.
MATTERHORN_SIGNUPS_ENABLED=true
MATTERHORN_SIGNUP_MAX_ACCOUNTS=100
# Require new accounts to verify ownership before any session is issued.
MATTERHORN_EMAIL_VERIFICATION_REQUIRED=true
MATTERHORN_EMAIL_FROM="Matterhorn Desks <accounts@example.com>"
# Cloudflare Turnstile is required for public account creation. The site key is
# public; keep the secret only in the backend secret manager. Production must
# allow only the exact public app hostname. Local deployments use a separate
# TURNSTILE_HOSTNAMES value containing localhost and/or 127.0.0.1.
MATTERHORN_TURNSTILE_SITEKEY=<turnstile-site-key>
TURNSTILE_SECRET=<turnstile-secret-from-secret-manager>
TURNSTILE_HOSTNAMES=app.matterhorn.example
# Record the exact legal documents accepted at account creation.
MATTERHORN_LEGAL_ACCEPTANCE_REQUIRED=true
MATTERHORN_TERMS_VERSION=<approved-terms-version>
MATTERHORN_PRIVACY_VERSION=<approved-privacy-version>
# Configure one server-side delivery provider. Resend is the shortest path;
# SMTP is supported for operators that already have a transactional relay.
MATTERHORN_RESEND_API_KEY=<resend-key-from-secret-manager>
# MATTERHORN_SMTP_HOST=smtp.example.com
# MATTERHORN_SMTP_PORT=587
# MATTERHORN_SMTP_USER=<smtp-user>
# MATTERHORN_SMTP_PASSWORD=<smtp-password-from-secret-manager>
# MATTERHORN_SMTP_SECURE=0
# Development only. Production ignores this even if it is set.
# MATTERHORN_EMAIL_DEV_MODE=1
# Free-beta inference protection. Keep enforcement hard in public deployments.
# A request reserves this amount before dispatch, then reconciles against the
# provider-reported completed token count. Pending reservations remain charged.
MATTERHORN_MODEL_USAGE_ENFORCEMENT=hard
MATTERHORN_MODEL_USAGE_DAILY_LIMIT=250000
MATTERHORN_MODEL_USAGE_MONTHLY_LIMIT=2000000
MATTERHORN_MODEL_USAGE_GLOBAL_DAILY_LIMIT=5000000
MATTERHORN_MODEL_USAGE_GLOBAL_MONTHLY_LIMIT=50000000
MATTERHORN_MODEL_USAGE_RESERVATION_TOKENS=32000
# Optional JSON weights by model ID or provider/model ID, for example:
# MATTERHORN_MODEL_USAGE_WEIGHTS_JSON={"asi1-mini":0.5,"cudos/meta-llama/llama-3.3-70b-instruct":2}
# Optional first-party model catalog URL. Omit when the deployment uses only
# explicitly configured providers such as ASI:Cloud.
# MATTERHORN_MODELS_URL=https://models.matterhorn.example

# Hyperliquid connected-wallet execution. Omit or set to 0 to fail closed.
MATTERHORN_HYPERLIQUID_EXECUTION_ENABLED=0
# Set the reviewed production per-order notional cap in USDC.
MATTERHORN_HYPERLIQUID_MAX_ORDER_USDC=1000

# Web app build-time connection
# Private/local web and desktop bridge builds may set VITE_MATTERHORN_WORK_URL
# in their secret manager. Do not set it in a public browser build.
#
# Public Beta web mode uses the authenticated same-origin proxy instead:
# Set this acknowledgement only after the edge routes both /workspaces and
# /opencode to the authenticated Matterhorn backend. The live deployment probe
# must still verify that unauthenticated requests receive a JSON 401 or 403.
# MATTERHORN_PUBLIC_PROXY_MODE=same-origin
# VITE_MATTERHORN_DEPLOYMENT=web
# VITE_MATTERHORN_PUBLIC_BETA=1
# Full non-secret release SHA embedded in the generated HTML for deployment
# attestation. Pass this as a Vercel build environment variable on every deploy.
# VITE_MATTERHORN_BUILD_COMMIT=0000000000000000000000000000000000000000
# Enables only the audited agent draft -> exact review -> connected-wallet
# approval -> public receipt paths. Agents and watches still cannot submit.
# VITE_MATTERHORN_REVIEWED_DESK_ACTIONS_ENABLED=1
# VITE_MATTERHORN_REQUIRE_SIGNIN=1
# VITE_MATTERHORN_CLOUD_ENABLED=1
# VITE_MATTERHORN_CLOUD_URL=https://app.matterhorn.example
# VITE_MATTERHORN_CLOUD_API_URL=https://app.matterhorn.example/api/den
# Never expose VITE_MATTERHORN_WORK_URL, VITE_MATTERHORN_WORK_TOKEN,
# VITE_MATTERHORN_WORK_HOST_TOKEN, or VITE_OPENCODE_URL in that build.
VITE_MATTERHORN_CLOUD_ENABLED=0
VITE_MATTERHORN_BILLING_ENABLED=0
VITE_MATTERHORN_GENERATED_MEDIA_ENABLED=0
VITE_MATTERHORN_EXPERIMENTAL_LOCALES_ENABLED=0
# Keep empty by default. Add a connector only after connect, reload, tool-call,
# disconnect, and revoked-account acceptance passes on the deployed candidate.
# VITE_MATTERHORN_PUBLIC_OAUTH_CONNECTORS=notion,linear

# Google Workspace remains hidden until the Matterhorn-branded OAuth consent
# identity and complete connect/reload/tool/disconnect/revoke flow are accepted.
# MATTERHORN_GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# MATTERHORN_GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# MATTERHORN_GOOGLE_WORKSPACE_TOKEN_BROKER_URL=
# Enable Cloud only after the Cloud acceptance suite passes:
# VITE_MATTERHORN_CLOUD_ENABLED=1
# VITE_MATTERHORN_CLOUD_URL=https://app.matterhorn.example
# VITE_MATTERHORN_CLOUD_API_URL=https://app.matterhorn.example/api/den
# Enable additional locales only after their Matterhorn terminology and onboarding review passes.
# VITE_MATTERHORN_EXPERIMENTAL_LOCALES_ENABLED=1

# Stripe test billing. Live charging must remain off for this launch gate.
MATTERHORN_BILLING_MODE=phase1_stripe_test
MATTERHORN_BILLING_PROVIDER=stripe
MATTERHORN_BILLING_CURRENT_PLAN=free
MATTERHORN_STRIPE_SECRET_KEY=<secret-manager-value>
MATTERHORN_STRIPE_WEBHOOK_SECRET=<stripe-whsec-test-from-secret-manager>
MATTERHORN_STRIPE_PRICE_ID_PLUS=price_replace_with_test_plus
MATTERHORN_STRIPE_PRICE_ID_MAX=price_replace_with_test_max
MATTERHORN_STRIPE_TEST_CUSTOMER_ID=cus_replace_with_test_customer

# Production image generation
MATTERHORN_IMAGE_PROVIDER=openai
OPENAI_API_KEY=<openai-key-from-secret-manager>
MATTERHORN_IMAGE_MODEL=gpt-image-1
MATTERHORN_IMAGE_SIZE=1024x1024
MATTERHORN_IMAGE_QUALITY=auto
MATTERHORN_IMAGE_FORMAT=png

# Public Walrus storage
MATTERHORN_WALRUS_PUBLISHER_URL=https://publisher.walrus.example
MATTERHORN_WALRUS_RELAY_URL=https://aggregator.walrus.example
MATTERHORN_WALRUS_STORAGE_EPOCHS=3
# Optional when the publisher requires bearer authentication:
# MATTERHORN_WALRUS_PUBLISHER_BEARER_TOKEN=<walrus-token-from-secret-manager>

# Sui testnet publishing packages. Use reviewed, deployed package IDs.
MATTERHORN_SUI_NETWORK=sui-testnet
MATTERHORN_SUI_NFT_PACKAGE_ID=0x_replace_with_64_hex_package_id
MATTERHORN_SUI_NFT_MODULE_NAME=matterhorn_media
MATTERHORN_SUI_KIOSK_PACKAGE_ID=0x_replace_with_64_hex_package_id
MATTERHORN_SUI_TRANSFER_POLICY_PACKAGE_ID=0x_replace_with_64_hex_package_id
# Optional defaults for automated listing acceptance; users may provide these in the UI:
# MATTERHORN_SUI_NFT_TYPE=0x...::matterhorn_media::MatterhornNFT
# MATTERHORN_SUI_KIOSK_ID=0x_replace_with_64_hex_object_id
# MATTERHORN_SUI_KIOSK_OWNER_CAP_ID=0x_replace_with_64_hex_object_id
# MATTERHORN_SUI_TRANSFER_POLICY_ID=0x_replace_with_64_hex_object_id
