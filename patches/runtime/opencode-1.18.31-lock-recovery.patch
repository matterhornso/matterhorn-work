@@ -0,0 +1,77 @@
+import { expect, test } from "bun:test"
+import { spawn } from "node:child_process"
+import { deadOwner, processScope } from "../../src/util/lock-owner"
+
+test("kernel scope is available on supported platforms and stable within the process", async () => {
+  const scope = await processScope()
+  if (process.platform === "darwin" || process.platform === "linux") expect(scope).toStartWith(`${process.platform}:`)
+  else expect(scope).toBeUndefined()
+  expect(await processScope()).toBe(scope)
+})
+
+test("proves a child absent only after it exits in this process namespace", async () => {
+  const scope = await processScope()
+  expect(scope).toBeDefined()
+  const child = spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], { stdio: "ignore" })
+  const closed = new Promise<void>((resolve) => child.once("close", () => resolve()))
+  try {
+    expect(typeof child.pid).toBe("number")
+    const meta = { processScope: scope, pid: child.pid }
+    expect(deadOwner(meta, scope)).toBe(false)
+    child.kill("SIGKILL")
+    await closed
+    expect(deadOwner(meta, scope)).toBe(true)
+  } finally {
+    child.kill("SIGKILL")
+    await closed
+  }
+})
+
+test("never probes an unrecognized host, namespace, legacy record or invalid PID", () => {
+  for (const meta of [
+    null,
+    [],
+    {},
+    { pid: 12 },
+    { processScope: "other-boot", pid: 12 },
+    ...[0, -1, 1.5, "12", NaN, Infinity, 2_147_483_648].map((pid) => ({ processScope: "this-boot", pid })),
+  ]) {
+    expect(
+      deadOwner(meta, "this-boot", () => {
+        throw new Error("must not probe")
+      }),
+    ).toBeUndefined()
+  }
+  expect(
+    deadOwner({ processScope: "this-boot", pid: 12 }, undefined, () => {
+      throw new Error("must not probe")
+    }),
+  ).toBeUndefined()
+})
+
+test("only ESRCH proves death; permission errors, unexpected errors and PID reuse preserve exclusion", () => {
+  const meta = { processScope: "this-boot", pid: 12 }
+  let calls = 0
+  for (const code of ["EPERM", "EACCES", "EINVAL", "EIO"]) {
+    expect(
+      deadOwner(meta, "this-boot", (pid, signal) => {
+        expect(pid).toBe(12)
+        expect(signal).toBe(0)
+        calls++
+        throw Object.assign(new Error("synthetic probe failure"), { code })
+      }),
+    ).toBe(false)
+  }
+  expect(calls).toBe(4)
+  expect(
+    deadOwner(meta, "this-boot", () => {
+      throw new Error("unknown")
+    }),
+  ).toBe(false)
+  expect(deadOwner(meta, "this-boot", () => {})).toBe(false)
+  expect(
+    deadOwner(meta, "this-boot", () => {
+      throw Object.assign(new Error("absent"), { code: "ESRCH" })
+    }),
+  ).toBe(true)
+})
