diff --git a/packages/core/src/util/lock-owner.ts b/packages/core/src/util/lock-owner.ts
new file mode 100644
index 0000000..35f774f
--- /dev/null
+++ b/packages/core/src/util/lock-owner.ts
@@ -0,0 +1,70 @@
+import { execFile } from "node:child_process"
+import { readFile, readlink } from "node:fs/promises"
+
+let scope: Promise<string | undefined> | undefined
+
+// Hostnames are not unique, and a PID in another container is not our PID.
+// Unknown platforms or unavailable kernel identity retain lease-based recovery.
+export function processScope() {
+  return (scope ??= readScope().catch(() => undefined))
+}
+
+async function readScope() {
+  if (process.platform === "linux") {
+    const [boot, namespace] = await Promise.all([
+      readFile("/proc/sys/kernel/random/boot_id", "utf8"),
+      readlink("/proc/self/ns/pid"),
+    ])
+    if (!uuid(boot.trim()) || !/^pid:\[\d+\]$/.test(namespace)) return
+    return `linux:${boot.trim().toLowerCase()}:${namespace}`
+  }
+  if (process.platform === "darwin") {
+    const boot = await new Promise<string>((resolve, reject) => {
+      execFile(
+        "/usr/sbin/sysctl",
+        ["-n", "kern.bootsessionuuid"],
+        { timeout: 1_000, maxBuffer: 256 },
+        (error, stdout) => {
+          if (error) reject(error)
+          else resolve(stdout.trim())
+        },
+      )
+    })
+    if (uuid(boot)) return `darwin:${boot.toLowerCase()}`
+  }
+}
+
+function uuid(value: string) {
+  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)
+}
+
+// Only ESRCH in the same boot/PID namespace proves absence. A reused live PID
+// or EPERM must not let another process enter the owner's critical section.
+export function deadOwner(
+  meta: unknown,
+  localScope: string | undefined,
+  probe: (pid: number, signal: 0) => void = process.kill,
+): boolean | undefined {
+  if (
+    !localScope ||
+    typeof meta !== "object" ||
+    meta === null ||
+    !("processScope" in meta) ||
+    meta.processScope !== localScope
+  )
+    return
+  if (
+    !("pid" in meta) ||
+    typeof meta.pid !== "number" ||
+    !Number.isSafeInteger(meta.pid) ||
+    meta.pid <= 0 ||
+    meta.pid > 2_147_483_647
+  )
+    return
+  try {
+    probe(meta.pid, 0)
+    return false
+  } catch (error) {
+    return typeof error === "object" && error !== null && "code" in error && error.code === "ESRCH"
+  }
+}
