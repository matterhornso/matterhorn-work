diff --git a/packages/opencode/test/installation/matterhorn.test.ts b/packages/opencode/test/installation/matterhorn.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/test/installation/matterhorn.test.ts
@@ -0,0 +1,39 @@
+import { expect } from "bun:test"
+import { Effect, Layer } from "effect"
+import { HttpClient } from "effect/unstable/http"
+import { ChildProcessSpawner } from "effect/unstable/process"
+import { makeGlobalNode } from "@opencode-ai/core/effect/app-node"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { httpClient } from "@opencode-ai/core/effect/app-node-platform"
+import { CrossSpawnSpawner } from "@opencode-ai/core/cross-spawn-spawner"
+import { InstallationChannel, InstallationVersion } from "@opencode-ai/core/installation/version"
+import { Installation } from "../../src/installation"
+import { testEffect } from "../lib/effect"
+
+let networkCalls = 0
+let processCalls = 0
+const http = HttpClient.make(() => {
+  networkCalls++
+  return Effect.die("Managed upgrades must not access the network")
+})
+const spawner = ChildProcessSpawner.make(() => {
+  processCalls++
+  return Effect.die("Managed upgrades must not spawn a package manager")
+})
+const spawnerNode = makeGlobalNode({ service: ChildProcessSpawner.ChildProcessSpawner,
+  layer: Layer.succeed(ChildProcessSpawner.ChildProcessSpawner, spawner), deps: [] })
+const layer = LayerNode.compile(Installation.node, [
+  [httpClient, Layer.succeed(HttpClient.HttpClient, http)], [CrossSpawnSpawner.node, spawnerNode],
+])
+testEffect(layer).effect("managed upgrades cannot fetch or execute stock installers", () => Effect.gen(function* () {
+  expect(InstallationChannel).toBe("matterhorn")
+  expect(yield* Installation.use.method()).toBe("unknown")
+  expect(yield* Installation.use.latest()).toBe(InstallationVersion)
+  const methods: Installation.Method[] = ["curl", "npm", "yarn", "pnpm", "bun", "brew", "scoop", "choco", "unknown"]
+  for (const method of methods) {
+    const error = yield* Effect.flip(Installation.use.upgrade(method, "9.9.9"))
+    expect(error).toBeInstanceOf(Installation.UpgradeFailedError)
+    expect(error.stderr).toContain("managed by Matterhorn")
+  }
+  expect([networkCalls, processCalls]).toEqual([0, 0])
+}))
