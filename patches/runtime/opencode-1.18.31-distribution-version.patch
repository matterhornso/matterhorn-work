diff --git a/packages/core/test/installation-version.test.ts b/packages/core/test/installation-version.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/test/installation-version.test.ts
@@ -0,0 +1,23 @@
+import { expect, test } from "bun:test"
+
+for (const [channel, version, dependency, local] of [
+  ["matterhorn", "1.18.31-matterhorn.1", "1.18.31", false],
+  ["latest", "1.18.31", "1.18.31", false],
+  ["local", "local", "local", true],
+]) {
+  test(`installation dependency version remains correct for ${channel}`, async () => {
+    const url = new URL("../src/installation/version.ts", import.meta.url).href
+    const script = `globalThis.OPENCODE_CHANNEL = ${JSON.stringify(channel)};
+      globalThis.OPENCODE_VERSION = ${JSON.stringify(version)};
+      const value = await import(${JSON.stringify(url)});
+      console.log(JSON.stringify([value.InstallationVersion, value.InstallationDependencyVersion, value.InstallationLocal]));`
+    const proc = Bun.spawn([process.execPath, "--eval", script], { stdout: "pipe", stderr: "pipe" })
+    const [code, stdout, stderr] = await Promise.all([
+      proc.exited, new Response(proc.stdout).text(), new Response(proc.stderr).text(),
+    ])
+    expect(stderr).toBe("")
+    expect(code).toBe(0)
+    expect(JSON.parse(stdout)).toEqual([version, dependency, local])
+  })
+}
+
