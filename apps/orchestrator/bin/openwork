#!/usr/bin/env node

const childProcess = require("child_process")
const path = require("path")

const canonicalWrapper = path.join(__dirname, "matterhorn-work")
const result = childProcess.spawnSync(process.execPath, [canonicalWrapper, ...process.argv.slice(2)], {
  stdio: "inherit",
})

if (result.error) {
  console.error(result.error.message)
  process.exit(1)
}

process.exit(typeof result.status === "number" ? result.status : 0)
